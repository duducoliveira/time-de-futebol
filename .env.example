# As variáveis têm o sufixo _POEIRA para conviver com outras contas no mesmo ambiente
# (o código também aceita o nome sem sufixo).
# --- Buffer (postagem + métricas agregadas) ---
# Gere em https://publish.buffer.com/settings/api (chave pessoal)
BUFFER_API_KEY_POEIRA=
# Opcional: se vazio, o script usa a primeira organização da conta
BUFFER_ORGANIZATION_ID_POEIRA=
# ID do canal Instagram no Buffer (rode: python -m timefc canais)
BUFFER_INSTAGRAM_CHANNEL_ID_POEIRA=

# --- Instagram API com Login do Instagram (leitura do TEXTO dos comentários) ---
# Conta precisa ser Profissional (Business ou Criador de conteúdo).
# Permissões: instagram_business_basic, instagram_business_manage_comments
INSTAGRAM_ACCESS_TOKEN_POEIRA=
INSTAGRAM_API_VERSION=v23.0
